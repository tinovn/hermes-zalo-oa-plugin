# ── Bắt buộc ──────────────────────────────────────────────────────────────
# Tạo app tại https://developers.zalo.me → liên kết Official Account
ZALO_OA_APP_ID=
# App Secret: KÝ OAUTH
ZALO_OA_APP_SECRET=
# OA Secret Key: XÁC THỰC CHỮ KÝ WEBHOOK — hai bí mật KHÁC NHAU, đừng hoán đổi
ZALO_OA_SECRET_KEY=
# URL HTTPS công khai trỏ về plugin (reverse proxy → ZALO_OA_WEBHOOK_PORT)
ZALO_OA_PUBLIC_BASE_URL=https://oa.example.com

# ── Tuỳ chọn ──────────────────────────────────────────────────────────────
ZALO_OA_OWNER_UID=
ZALO_OA_SESSION_DIR=/opt/data/zalo-oa
ZALO_OA_WEBHOOK_HOST=127.0.0.1
ZALO_OA_WEBHOOK_PORT=3939
ZALO_OA_WEBHOOK_PATH=/webhooks/zalo-oa
# false = CHẶN mọi tin ngoài khung 48h (mặc định, không tự đốt tiền)
ZALO_OA_ALLOW_PAID_WINDOW=false
ZALO_OA_WELCOME_MESSAGE=
ZALO_OA_MAX_MESSAGE_LENGTH=2000
ZALO_OA_HOME_CHANNEL=
